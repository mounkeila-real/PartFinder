generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Model for locally caching WMI identifiers to limit API calls
model WmiCode {
  id        Int      @id @default(autoincrement())
  wmi       String   @unique
  make      String
  country   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Local cache/catalog of frequently searched parts to augment eBay returns
model PartCatalog {
  id          Int      @id @default(autoincrement())
  oem         String   @unique
  name        String
  description String?
  basePrice   Float?   // Cached reference price before margin
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Comptes utilisateurs (B2B — garages / professionnels)
model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  companyName  String                        // Raison sociale
  contactName  String?                       // Nom du contact
  phone        String?
  vatNumber    String?                       // N° TVA intracom / SIRET
  role         String   @default("CUSTOMER") // CUSTOMER | ADMIN
  status       String   @default("ACTIVE")   // ACTIVE | SUSPENDED
  orders       Order[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// User purchase intents
model Order {
  id          Int         @id @default(autoincrement())
  status      String      @default("PENDING")
  totalAmount Float
  contactInfo String?
  userId      Int?                            // Lien vers le compte (null = commande invité / héritée)
  user        User?       @relation(fields: [userId], references: [id])
  shippingAddress String?                     // Adresse de livraison (Phase 2)
  items       OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model OrderItem {
  id        Int    @id @default(autoincrement())
  orderId   Int
  order     Order  @relation(fields: [orderId], references: [id])
  partOem   String
  partName  String
  quantity  Int    @default(1)
  priceSold Float  // Price with margin applied
}

// Vehicle Database Models (imported from vehicle-make-model-data)
model VehicleMake {
  id        Int                @id @default(autoincrement())
  name      String             @unique
  years     VehicleModelYear[]
  models    VehicleModel[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
}

model VehicleModelYear {
  id        Int            @id @default(autoincrement())
  year      Int
  makeId    Int
  make      VehicleMake    @relation(fields: [makeId], references: [id])
  models    VehicleModel[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([makeId, year])
}

model VehicleModel {
  id          Int              @id @default(autoincrement())
  name        String
  makeId      Int
  make        VehicleMake      @relation(fields: [makeId], references: [id])
  makeYearId  Int
  makeYear    VehicleModelYear @relation(fields: [makeYearId], references: [id])
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([makeYearId, name])
}

// Model for caching full VIN decode results locally
model Vehicle {
  vin            String   @id @unique
  make           String
  model          String
  year           Int?
  engine         String?
  specifications String   // JSON string storing all Vincario parameters
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
