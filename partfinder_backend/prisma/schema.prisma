generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Model for locally caching WMI identifiers to limit API calls
model WmiCode {
  id        Int      @id @default(autoincrement())
  wmi       String   @unique
  make      String
  country   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Local cache/catalog of frequently searched parts to augment eBay returns
model PartCatalog {
  id          Int      @id @default(autoincrement())
  oem         String   @unique
  name        String
  description String?
  basePrice   Float?   // Cached reference price before margin
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// User purchase intents
model Order {
  id          Int         @id @default(autoincrement())
  status      String      @default("PENDING")
  totalAmount Float
  contactInfo String?
  items       OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model OrderItem {
  id        Int    @id @default(autoincrement())
  orderId   Int
  order     Order  @relation(fields: [orderId], references: [id])
  partOem   String
  partName  String
  quantity  Int    @default(1)
  priceSold Float  // Price with margin applied
}

