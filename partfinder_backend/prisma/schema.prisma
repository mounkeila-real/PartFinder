generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Model for locally caching WMI identifiers to limit API calls
model WmiCode {
  id        Int      @id @default(autoincrement())
  wmi       String   @unique
  make      String
  country   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Local cache/catalog of frequently searched parts to augment eBay returns
model PartCatalog {
  id          Int      @id @default(autoincrement())
  oem         String   @unique
  name        String
  description String?
  basePrice   Float?   // Cached reference price before margin
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Comptes utilisateurs (B2B — garages / professionnels)
model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  companyName  String                        // Raison sociale
  contactName  String?                       // Nom du contact
  phone        String?
  vatNumber    String?                       // N° TVA intracom / SIRET
  role         String   @default("CUSTOMER") // CUSTOMER | ADMIN
  status       String   @default("ACTIVE")   // ACTIVE | SUSPENDED
  resetToken   String?
  resetTokenExpiry DateTime?
  orders       Order[]
  vehicles     SavedVehicle[]
  addresses    Address[]
  inboundParcels   InboundParcel[]
  outboundShipments OutboundShipment[]
  paymentRequests  PaymentRequest[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Véhicules enregistrés dans le garage d'un compte (B2B)
model SavedVehicle {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vin       String?
  plate     String?
  make      String?
  model     String?
  year      Int?
  engine    String?
  nickname  String?                             // Ex: "Fourgon Clio de M. Durand"
  createdAt DateTime @default(now())
}

// User purchase intents
model Order {
  id          Int         @id @default(autoincrement())
  status      String      @default("PENDING")
  totalAmount Float
  contactInfo String?
  userId      Int?                            // Lien vers le compte (null = commande invité / héritée)
  user        User?       @relation(fields: [userId], references: [id])
  shippingAddress String?                     // Adresse de livraison
  poReference String?                         // Bon de commande / réf interne garage
  paymentStatus String    @default("UNPAID")  // UNPAID | PAID | FAILED
  stripeSessionId String?                     // Session Stripe Checkout
  paymentUrl  String?                         // Lien de paiement Stripe en cours
  quotedAmount Decimal?  @db.Decimal(10, 2)   // Prix définitif fixé par l'opérateur
  adminNote   String?                         // Explication de l'ajustement (visible client)
  validatedAt DateTime?                       // Date de validation par l'opérateur
  items       OrderItem[]
  inboundParcels InboundParcel[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model OrderItem {
  id        Int    @id @default(autoincrement())
  orderId   Int
  order     Order  @relation(fields: [orderId], references: [id])
  partOem   String
  partName  String
  quantity  Int    @default(1)
  priceSold Float  // Price with margin applied
  // Coût d'acquisition — INTERNE, jamais exposé au client.
  // Sert à l'opérateur pour arrêter le prix définitif et vérifier la marge.
  sourcePriceEur    Decimal? @db.Decimal(10, 2)
  sourceShippingEur Decimal? @db.Decimal(10, 2)  // null = port vendeur inconnu
  sourceShippingType String?                     // FIXED | CALCULATED | null
  categoryCode      String?                      // catégorie retenue (poids de référence)
  poidsEstimeKg     Decimal? @db.Decimal(6, 2)
}

// Vehicle Database Models (imported from vehicle-make-model-data)
model VehicleMake {
  id        Int                @id @default(autoincrement())
  name      String             @unique
  years     VehicleModelYear[]
  models    VehicleModel[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
}

model VehicleModelYear {
  id        Int            @id @default(autoincrement())
  year      Int
  makeId    Int
  make      VehicleMake    @relation(fields: [makeId], references: [id])
  models    VehicleModel[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([makeId, year])
}

model VehicleModel {
  id          Int              @id @default(autoincrement())
  name        String
  makeId      Int
  make        VehicleMake      @relation(fields: [makeId], references: [id])
  makeYearId  Int
  makeYear    VehicleModelYear @relation(fields: [makeYearId], references: [id])
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([makeYearId, name])
}

// Model for caching full VIN decode results locally
model Vehicle {
  vin            String   @id @unique
  make           String
  model          String
  year           Int?
  engine         String?
  specifications String   // JSON string storing all Vincario parameters
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ═══════════════════════════════════════════════════════════════════
// TARIFICATION TOUT COMPRIS / ENTREPÔT / RÉEXPÉDITION
// Statuts de commande (Order.status) :
//   PENDING_VALIDATION, AWAITING_PAYMENT, PENDING, CONFIRMED, PROCESSING,
//   PENDING_WEIGHT_CONFIRMATION, PENDING_ADDITIONAL_PAYMENT,
//   RECEIVED_AT_WAREHOUSE, READY_TO_SHIP, SHIPPED, DELIVERED, CANCELLED, ISSUE
// Tous les montants sont en Decimal (numeric) — jamais de Float.
// ═══════════════════════════════════════════════════════════════════

// Référentiel des catégories de pièces : poids/dimensions de référence
// servant à estimer le port avant pesée réelle.
model PartCategory {
  id           Int      @id @default(autoincrement())
  code         String   @unique
  labelFr      String
  poidsKg      Decimal  @db.Decimal(6, 2)
  longueurCm   Int?
  largeurCm    Int?
  hauteurCm    Int?
  poidsVerifie Boolean  @default(false)   // true après pesées réelles concordantes
  horsGabarit  Boolean  @default(false)   // hors normes Colissimo
  synonymes    String[] @default([])
  classifications AiClassification[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Grille Colissimo Outre-mer, versionnée par dates de validité
// (mise à jour annuelle sans écraser l'historique).
model ColissimoRate {
  id         Int       @id @default(autoincrement())
  zone       String                              // OM1 | OM2
  poidsMaxKg Decimal   @db.Decimal(6, 2)
  prixEur    Decimal   @db.Decimal(10, 2)
  valideDu   DateTime  @db.Date
  valideAu   DateTime? @db.Date
  createdAt  DateTime  @default(now())

  @@index([zone, poidsMaxKg])
}

// Frais de traitement par tranche de valeur déclarée.
model ProcessingFeeTier {
  id           Int      @id @default(autoincrement())
  valeurMinEur Decimal  @db.Decimal(10, 2)
  valeurMaxEur Decimal? @db.Decimal(10, 2)      // null = infini
  fraisEur     Decimal  @db.Decimal(10, 2)
  createdAt    DateTime @default(now())
}

// Paramètres de tarification éditables en admin (sans redéploiement).
model PricingSetting {
  key       String   @id
  value     String
  type      String   @default("number")          // number | boolean | string
  label     String?
  updatedAt DateTime @updatedAt
}

// Journal des modifications de paramètres (qui, quand, ancienne → nouvelle).
model PricingSettingLog {
  id        Int      @id @default(autoincrement())
  key       String
  oldValue  String?
  newValue  String
  userId    Int?
  createdAt DateTime @default(now())
}

// Cache de classification IA : un titre normalisé n'est jamais reclassifié.
model AiClassification {
  id                 Int           @id @default(autoincrement())
  titreNormalise     String        @unique  // clé de cache (titre normalisé + empreinte description)
  titreOrigine       String?                // titre lisible, pour la revue opérateur
  categoryId         Int?
  category           PartCategory? @relation(fields: [categoryId], references: [id])
  confiance          Decimal       @db.Decimal(4, 3)
  // Nombre d'unités de la catégorie (ex. « 2 disques » -> 2, « jeu de 4 plaquettes » -> 1
  // car la catégorie « jeu de plaquettes » est déjà l'unité).
  quantite           Int           @default(1)
  poidsEstimeKg      Decimal?      @db.Decimal(6, 2)  // poids retenu = poids catégorie x quantité
  valideParOperateur Boolean       @default(false)
  createdAt          DateTime      @default(now())

  @@index([valideParOperateur])
}

// Traductions déjà obtenues — une description n'est jamais retraduite.
// Le quota DeepL gratuit est limité : sans ce cache, chaque consultation
// d'une même annonce le consommerait à nouveau.
model TranslationCache {
  id           Int      @id @default(autoincrement())
  sourceHash   String   @unique              // sha1 du texte source
  sourceLang   String?                       // détectée par le moteur
  targetLang   String   @default("FR")
  texteTraduit String
  moteur       String   @default("deepl")
  nbCaracteres Int      @default(0)          // suivi de consommation du quota
  createdAt    DateTime @default(now())

  @@index([targetLang])
  @@map("translation_cache")
}

// Vendeurs professionnels ciblés en priorité (casses européennes).
// Une recherche générale noie les grosses casses parmi les particuliers :
// on interroge donc AUSSI ces vendeurs nommément.
model SupplierSeller {
  id                 Int       @id @default(autoincrement())
  supplierCode       String    @default("EBAY")
  sellerUsername     String
  labelInterne       String                          // ex. "Ovoko/RRR — casse europeenne"
  pays               String?
  actif              Boolean   @default(true)
  priorite           Int       @default(0)           // tri a prix comparable
  fiabiliteScore     Decimal   @default(1.0) @db.Decimal(3, 2)
  notes              String?
  // Verification : un username errone renvoie 0 resultat SANS erreur.
  // On garde la trace du dernier controle pour rendre la panne visible.
  verifieLe          DateTime?
  dernierNbResultats Int?
  createdAt          DateTime  @default(now())

  @@unique([supplierCode, sellerUsername])
  @@index([supplierCode, actif])
  @@map("supplier_sellers")
}

// Adresses de livraison du client (la zone pilote le tarif Colissimo).
model Address {
  id           Int      @id @default(autoincrement())
  userId       Int
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  destinataire String
  ligne1       String
  ligne2       String?
  codePostal   String
  ville        String
  territoire   String                            // GUADELOUPE, REUNION, POLYNESIE...
  zone         String                            // OM1 | OM2
  telephone    String?
  parDefaut    Boolean  @default(false)
  shipments    OutboundShipment[]
  createdAt    DateTime @default(now())

  @@index([userId])
}

// Colis entrants à l'entrepôt (issus d'une commande, ou réexpédition seule).
model InboundParcel {
  id             Int       @id @default(autoincrement())
  orderId        Int?
  order          Order?    @relation(fields: [orderId], references: [id])
  userId         Int
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  trackingNumber String?
  transporteur   String?
  statut         String    @default("EXPECTED")  // EXPECTED|RECEIVED|WEIGHED|ISSUE|CONSOLIDATED|SHIPPED
  poidsReelKg    Decimal?  @db.Decimal(6, 2)
  longueurCm     Int?
  largeurCm      Int?
  hauteurCm      Int?
  photos         Json      @default("[]")
  notesOperateur String?
  annonce        Boolean   @default(true)        // false = colis non annoncé (supplément)
  receivedAt     DateTime?
  weighedAt      DateTime?
  createdAt      DateTime  @default(now())

  @@index([statut])
  @@index([trackingNumber])
}

// Réexpéditions vers le client (Colissimo Outre-mer).
model OutboundShipment {
  id                Int       @id @default(autoincrement())
  userId            Int
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId           Int?
  inboundParcelIds  Int[]     @default([])
  addressId         Int?
  address           Address?  @relation(fields: [addressId], references: [id])
  zone              String                        // OM1 | OM2
  poidsFactureKg    Decimal?  @db.Decimal(6, 2)
  portEur           Decimal?  @db.Decimal(10, 2)
  assurance         String    @default("STANDARD") // STANDARD | AD_VALOREM
  valeurDeclareeEur Decimal?  @db.Decimal(10, 2)
  cn23Data          Json?
  trackingColissimo String?
  statut            String    @default("PREPARING") // PREPARING|LABEL_READY|SHIPPED|DELIVERED
  shippedAt         DateTime?
  createdAt         DateTime  @default(now())

  @@index([statut])
}

// Appels de fonds (écart de poids, stockage, suppléments).
model PaymentRequest {
  id              Int       @id @default(autoincrement())
  userId          Int
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId         Int?
  shipmentId      Int?
  motif           String                          // ECART_POIDS|STOCKAGE|SUPPLEMENT|AUTRE
  montantEur      Decimal   @db.Decimal(10, 2)
  detail          String?
  statut          String    @default("PENDING")   // PENDING | PAID | CANCELLED | REFUSED
  lienPaiement    String?
  stripeSessionId String?
  createdAt       DateTime  @default(now())
  paidAt          DateTime?

  @@index([statut])
}
