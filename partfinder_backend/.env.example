# Backend PartFinder — variables d'environnement
DATABASE_URL="postgresql://user:password@host:port/db"   # Postgres (Railway). Ex local: pointe sur la base Railway.
PORT=3001                       # Port du backend
GEMINI_API_KEY=""               # Clé Google Gemini (OCR carte grise, chat) — optionnel
ANTHROPIC_API_KEY=""            # Clé Anthropic — optionnel
RAILWAY_TOKEN=""                # Déploiement Railway — optionnel
VINCARIO_API_KEY=""             # Décodage VIN premium Vincario — optionnel
VINCARIO_SECRET_KEY=""          # Secret Vincario — optionnel

# --- eBay Browse API (recherche de pièces) ---
EBAY_ENV="production"           # "sandbox" (tests) ou "production" (vraies annonces)
EBAY_APP_ID=""                  # eBay Client ID (App ID)
EBAY_CERT_ID=""                 # eBay Client Secret (Cert ID)
EBAY_MARKETPLACE_ID="EBAY_FR"   # Marché eBay ciblé (EBAY_FR, EBAY_DE, EBAY_US...)
EBAY_CATEGORY_ID="6030"         # Catégorie pièces auto (Vehicle Parts & Accessories)

# eBay — conformité "Marketplace Account Deletion" (requis pour la Production)
EBAY_VERIFICATION_TOKEN=""      # Chaîne 32-80 caractères (a-z A-Z 0-9 _ -), identique au formulaire eBay
EBAY_DELETION_ENDPOINT=""       # URL HTTPS exacte de l'endpoint, ex: https://<backend>/api/ebay/marketplace-deletion

# --- IA détermination de pièce ---
ANTHROPIC_MODEL="claude-3-5-sonnet-latest"  # Modèle Anthropic utilisé (optionnel)
PART_MARGIN_MULTIPLIER="1.33"   # Marge appliquée sur le prix source (1.33 = +33%)
