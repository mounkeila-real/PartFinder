{
  "name": "partfinder",
  "version": "1.0.0",
  "description": "Moteur de recherche de pièces automobiles",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build:css": "npx tailwindcss@3 -c ./tailwind.config.js -i ./src/input.css -o ./public/css/tailwind.css --minify",
    "watch:css": "npx tailwindcss@3 -c ./tailwind.config.js -i ./src/input.css -o ./public/css/tailwind.css --watch"
  },
  "dependencies": {
    "@google/genai": "^1.0.0",
    "axios": "^1.6.8",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "multer": "^1.4.5-lts.1"
  }
}